<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/frameLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnDream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/cyber_pink"
            android:textColor="@color/cyber_green"
            android:text="@string/button_morning"
            android:onClick="btnDreamClick" />

        <Button
            android:id="@+id/btnPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/cyber_pink"
            android:textColor="@color/cyber_green"
            android:text="@string/button_day"
            android:onClick="btnPathClick" />

        <Button
            android:id="@+id/btnCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/cyber_pink"
            android:textColor="@color/cyber_green"
            android:text="@string/button_evening"
            android:onClick="btnCityClick" />

        <Button
            android:id="@+id/btnFinal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/cyber_pink"
            android:textColor="@color/cyber_green"
            android:text="@string/button_night"
            android:onClick="btnFinalClick" />
    </LinearLayout>

    <!-- Контейнер для локаций -->
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- 4. Финал (Смерть) -->
        <ImageView
            android:id="@+id/imageFinal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/img4" />

        <!-- 3. Город (Найт-Сити) -->
        <ImageView
            android:id="@+id/imageCity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/img3" />

        <!-- 2. Путь (Дэвид) -->
        <ImageView
            android:id="@+id/imagePath"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/img2" />

        <!-- 1. Мечта (Луна, Люси и Дэвид) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageDream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/img1" />

            <!-- Невидимые кнопки для интерактива поверх фото -->

            <Button
                android:id="@+id/btnDavid"
                android:layout_width="135dp"
                android:layout_height="287dp"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="40dp"
                android:background="@android:color/transparent"
                android:onClick="onDavidClick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Остальные кнопки оставил на своих местах, просто переименовал id -->
            <Button
                android:id="@+id/btnLucy"
                android:layout_width="140dp"
                android:layout_height="292dp"
                android:layout_marginEnd="44dp"
                android:layout_marginBottom="32dp"
                android:background="@android:color/transparent"
                android:onClick="onLucyClick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnMoon"
                android:layout_width="211dp"
                android:layout_height="277dp"
                android:background="@android:color/transparent"
                android:onClick="onMoonClick"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>